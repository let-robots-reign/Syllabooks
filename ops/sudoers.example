# Validate with visudo and install as /etc/sudoers.d/syllabooks-deploy with
# mode 0440. Confirm the absolute command paths on the VPS before installing.
zotov ALL=(root) NOPASSWD: /usr/bin/install -o root -g root -m 0755 /home/zotov/.local/state/syllabooks-deploy/incoming /opt/syllabooks/syllabooks.new, /usr/bin/mv /opt/syllabooks/syllabooks /opt/syllabooks/syllabooks.previous, /usr/bin/mv /opt/syllabooks/syllabooks.new /opt/syllabooks/syllabooks, /usr/bin/mv /opt/syllabooks/syllabooks.previous /opt/syllabooks/syllabooks, /usr/bin/systemctl restart syllabooks, /usr/bin/systemctl --no-pager --full status syllabooks
