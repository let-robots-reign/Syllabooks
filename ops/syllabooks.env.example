# Install as /etc/syllabooks/syllabooks.env, owned by root:root with mode 600.
# systemd reads this file directly; do not add `export` or shell substitutions.

LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=https://syllabooks.ru
DATABASE_URL=postgres://syllabooks:replace-with-a-url-escaped-password@127.0.0.1:5432/syllabooks?sslmode=disable
BOOK_COVERS_DIR=/var/lib/syllabooks/book-covers
LOAN_DAYS=21

# Generate a long random value and encode this exact text in the shelf QR.
SHELF_CODE=replace-with-a-long-random-value

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=

# Optional at this scale. Public Google Books lookup works without it, subject
# to the provider's anonymous quota.
GOOGLE_BOOKS_API_KEY=
