# Copy to .env (git-ignored): cp .env.example .env
#
# Docker Compose reads .env automatically and passes settings to the
# containers as environment variables. The Go backend only ever reads its
# environment; it never opens this file.

# Postgres credentials. Also used to build the backend's DATABASE_URL, so keep
# the password URL-safe (letters and digits).
POSTGRES_USER=syllabooks
POSTGRES_PASSWORD=syllabooks
POSTGRES_DB=syllabooks
# Host port for psql and GUI clients. Bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# Host port for the app (Caddy): http://localhost:8000
HTTP_PORT=8000

# Yandex OAuth app, from https://oauth.yandex.ru. Leave empty to run without
# Yandex login. The app needs this redirect URI for development:
#   http://localhost:8000/api/auth/callback/yandex
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID app, from https://id.vk.com/about/business. Leave empty to run without
# VK login. No secret: VK ID's code exchange uses PKCE instead. Add this as a
# trusted redirect URL for development:
#   http://localhost:8000/api/auth/callback/vk
VK_CLIENT_ID=

# Optional. Public Google Books lookups work without a key at this scale; set
# one in production if anonymous quota becomes unreliable.
GOOGLE_BOOKS_API_KEY=
